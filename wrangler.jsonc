{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mv-counter",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/quota"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "NOTIFY_KV",
      "id": "7620011793a94ffa916d0cea4f3f2a1e"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "USER_DB",
      "database_name": "mv-counter-users",
      "database_id": "0344ca81-5a3a-46ed-95d5-fa59b5aed7df"
    }
  ]
}
